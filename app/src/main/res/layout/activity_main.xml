<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface">

    <androidx.camera.view.PreviewView android:id="@+id/preview"
        android:layout_width="match_parent" android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <ge.sigara.scanner.ViewfinderView android:id="@+id/viewfinder"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <LinearLayout android:id="@+id/topBar" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|start" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_logo"
            android:src="@drawable/ic_launcher_foreground" android:scaleX="1.7" android:scaleY="1.7"
            android:contentDescription="@string/logo_desc" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="14dp" android:text="@string/app_name"
            android:textColor="@color/on_surface" android:textSize="22sp" android:textStyle="bold"
            android:shadowColor="#99000000" android:shadowRadius="6" />
    </LinearLayout>

    <LinearLayout android:id="@+id/pill" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_pill" android:padding="10dp" android:minHeight="64dp">
        <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/status_searching"
            android:textColor="@color/on_surface" android:textSize="16sp" />
        <Button android:id="@+id/rescan" android:layout_width="wrap_content" android:layout_height="44dp"
            android:background="@drawable/bg_button" android:text="@string/rescan" android:textAllCaps="false"
            android:textColor="@color/surface" android:textStyle="bold" android:paddingStart="16dp"
            android:paddingEnd="16dp" android:visibility="gone" />
        <ImageButton android:id="@+id/torch" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginStart="8dp" android:background="@drawable/bg_torch" android:src="@drawable/ic_flash"
            android:contentDescription="@string/torch" />
    </LinearLayout>

    <LinearLayout android:id="@+id/permissionPanel" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/surface" android:gravity="center" android:orientation="vertical"
        android:padding="32dp" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/permission_needed" android:textColor="@color/on_surface" android:textSize="20sp" />
        <Button android:id="@+id/grant" android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_marginTop="20dp" android:background="@drawable/bg_button"
            android:text="@string/permission_grant" android:textAllCaps="false" android:textColor="@color/surface"
            android:paddingStart="24dp" android:paddingEnd="24dp" />
    </LinearLayout>
</FrameLayout>
